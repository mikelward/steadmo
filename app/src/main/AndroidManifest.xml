<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: the status bar chip while out of range (SPEC.md §4.3). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The urgent low alarm takes over the screen once ignored (SPEC.md §4.8). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Calendar meals and restaurant bookings, read on the device (SPEC.md §4.14); asked for only when turned on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Reminders on time, once the user allows "Alarms & reminders" (SPEC.md §4.13); inexact without it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arm alarms and nudge the notification listener after a reboot (SPEC.md §4.17). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility, to open CamAPS FX from the Boost, Ease-off and bolus buttons. -->
    <queries>
        <package android:name="com.camdiab.fx_alert.mmoll" />
        <package android:name="com.camdiab.fx_alert.mgdl" />
        <package android:name="com.camdiab.fx_alert.hx.mmoll" />
        <package android:name="com.camdiab.fx_alert.hx.mgdl" />
    </queries>

    <application
        android:name=".SteadmoApp"
        android:allowBackup="false"
        android:icon="${launcherIcon}"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Steadmo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The widget's buttons: no UI, just copies the amount and opens CamAPS FX. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".widget.SteadmoWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/steadmo_widget_info" />
        </receiver>

        <!-- The no-glucose check (SPEC.md §4.7), set by Steadmo's own alarm. -->
        <receiver
            android:name=".SignalWatchReceiver"
            android:exported="false" />

        <!-- The urgent low alarm, full screen over the lock screen (SPEC.md §4.8). -->
        <activity
            android:name=".UrgentLowActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- OK on the urgent low alarm (SPEC.md §4.8). -->
        <receiver
            android:name=".UrgentLowAckReceiver"
            android:exported="false" />

        <!-- "Treated" on low alerts, and its recheck reminder (SPEC.md §4.10). -->
        <receiver
            android:name=".TreatedReceiver"
            android:exported="false" />
        <receiver
            android:name=".RecheckReceiver"
            android:exported="false" />

        <!-- Quick Settings tiles (SPEC.md §4.11). Each redraws whenever the shade opens. -->
        <service
            android:name=".GlucoseTileService"
            android:exported="true"
            android:icon="@drawable/ic_trend_flat"
            android:label="@string/tile_glucose"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".MealTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_meal"
            android:label="@string/tile_meal"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The daily meal reminder and its snoozes (SPEC.md §4.13). -->
        <receiver
            android:name=".MealReminderReceiver"
            android:exported="false" />
        <!-- The weekly report alarm (SPEC.md §4.16). -->
        <receiver
            android:name=".WeeklyReportReceiver"
            android:exported="false" />
        <!-- Exported only for these system broadcasts, which other apps can't send. -->
        <receiver
            android:name=".ExactAlarmPermissionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shares bug report screenshots with the app the user picks. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".CamapsListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Only CamAPS FX matters; ongoing and silent are where its status lives. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="ongoing|silent|alerting" />
        </service>

        <!-- CamAPS FX shortcuts (SPEC.md §4.6), off until the user turns it on in Accessibility. -->
        <service
            android:name=".CamapsShortcutsService"
            android:exported="true"
            android:label="@string/shortcuts_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/camaps_shortcuts" />
        </service>
    </application>
</manifest>
